{
  "name": "autodudes/cheddi-classic-bundle",
  "description": "Third-party libraries of cheddi for TYPO3 classic mode installations. Built by Build/bundle-libs.sh, not used in Composer mode.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "phpoffice/phpspreadsheet": "^3.10",
    "phpoffice/phpword": "^1.4",
    "smalot/pdfparser": "^2.12"
  },
  "replace": {
    "composer/pcre": "*",
    "psr/clock": "*",
    "psr/log": "*",
    "symfony/clock": "*",
    "symfony/polyfill-mbstring": "*"
  },
  "config": {
    "vendor-dir": "ComposerVendor",
    "platform": {
      "php": "8.1.0"
    },
    "platform-check": false,
    "optimize-autoloader": true,
    "autoloader-suffix": "CheddiClassicBundle",
    "sort-packages": true,
    "allow-plugins": false
  }
}
