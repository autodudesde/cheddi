{
  "name": "autodudes/cheddi",
  "type": "typo3-cms-extension",
  "description": "ChEddi: AI assistant for the TYPO3 backend. A chat drawer on every backend page where editors work on pages, content, translations, metadata and other data in plain language.",
  "homepage": "https://www.autodudes.de/",
  "license": [
    "GPL-2.0-or-later"
  ],
  "version": "0.3.0",
  "keywords": [
    "TYPO3 CMS",
    "backend",
    "editor",
    "assistant",
    "chat",
    "content",
    "AI Assistant",
    "AI Suite"
  ],
  "require": {
    "php": "^8.1",
    "autodudes/ai-suite": "^12.24.0 || ^13.18.0 || ^14.6.0",
    "autodudes/ai-suite-mcp": "^0.9",
    "typo3/cms-core": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "typo3/cms-workspaces": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "typo3/cms-reports": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "typo3/cms-scheduler": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "phpoffice/phpspreadsheet": "^3.10",
    "phpoffice/phpword": "^1.4",
    "symfony/clock": "^6.4 || ^7.0 || ^8.0",
    "smalot/pdfparser": "^2.12"
  },
  "autoload": {
    "psr-4": {
      "AutoDudes\\Cheddi\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "cheddi",
      "Package": {
        "providesPackages": {
          "phpoffice/phpspreadsheet": "Resources/Private/PHP/ComposerVendor",
          "phpoffice/phpword": "Resources/Private/PHP/ComposerVendor",
          "smalot/pdfparser": "Resources/Private/PHP/ComposerVendor",
          "symfony/clock": ""
        }
      }
    }
  }
}
